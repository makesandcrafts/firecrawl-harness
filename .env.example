# firecrawl-harness configuration template.
# Copy to `.env` in this repo (gitignored) or to
#   ~/.config/firecrawl-harness/config
# and edit. KEY=VALUE lines; '#' starts a comment; real env vars win over files.

# REQUIRED — your self-hosted SearXNG search endpoint with JSON output
# enabled (a request like '<url>?q=test&format=json' must return a results list):
SEARXNG_URL=https://searxng.example.org/search

# OPTIONAL — self-hosted Firecrawl API (defaults to loopback):
# FIRECRAWL_API_URL=http://127.0.0.1:3002

# OPTIONAL — required only if FIRECRAWL_API_URL points at a non-loopback host:
# FC_ALLOW_REMOTE_API=1
